# Copy to .env.local and fill in. Never commit .env.local.
#
# From the Turso dashboard (or `turso db show` / `turso db tokens create`):
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Shared secret for /admin. Reads stay public; create, update and delete
# require this. Leave unset to disable writes entirely (the API fails closed).
ADMIN_PASSWORD=

# From console.anthropic.com — powers the "Generate with AI" button in /admin.
# Leave unset to disable generation entirely (fails closed, same as above).
ANTHROPIC_API_KEY=
