# Copy to .env.local and fill in. Never commit .env.local.
#
# There are two Turso databases. .env.local points at the DEV one, so nothing
# you run locally can touch the live site. Production credentials are pulled
# with `vercel env pull <file> --environment=production` when you actually
# need them.
#
# A Turso auth token is scoped to a single database. A token generated on the
# production database returns 401 against the dev database, so create the
# token from the dev database's own page.
#
# From the Turso dashboard (or `turso db show` / `turso db tokens create`):
TURSO_DATABASE_URL=libsql://litmag-dev-your-org.turso.io
TURSO_AUTH_TOKEN=

# Shared secret for /admin. Reads stay public; create, update and delete
# require this. Leave unset to disable writes entirely (the API fails closed).
ADMIN_PASSWORD=

# From console.anthropic.com — powers the "Generate with AI" button in /admin.
# Leave unset to disable generation entirely (fails closed, same as above).
ANTHROPIC_API_KEY=
